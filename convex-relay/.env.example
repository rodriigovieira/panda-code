# Convex writes CONVEX_URL / CONVEX_DEPLOYMENT into .env.local for you when you
# run `pnpm exec convex dev`. Do not commit that file — it is gitignored.
#
# This file documents the environment the relay reads. Nothing here is required
# to run Panda Code: the desktop app works fully locally with no relay at all.

# Your Convex deployment URL, written by `convex dev`. Copy this value into
# PANDA_CODE_RELAY_URL when building the desktop app so it can reach your relay.
CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------------------
# Push notifications (optional, iOS only)
#
# These are set on the Convex DEPLOYMENT, not in this file:
#   pnpm exec convex env set APNS_KEY_ID <value>
#
# Two silent failure modes to watch for:
#   1. A private key pasted without its newlines fails to parse and sends are
#      dropped with no error. Use: convex env set APNS_PRIVATE_KEY "$(cat key.p8)"
#   2. A development build registers a SANDBOX push token, which the production
#      APNs endpoint rejects. Build type and endpoint must agree.
# ---------------------------------------------------------------------------
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
